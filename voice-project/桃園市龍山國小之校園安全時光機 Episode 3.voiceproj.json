 "lines": [
  {
   "id": "002",
   "role": "nar",
   "text": "下課時間，你在悠悅樓的平台上休息，小美跑了過來。",
   "instruct": "輕鬆地開場"
  },
  {
   "id": "003",
   "role": "xiaomei",
   "text": "我們來比力氣！我最近每天幫媽媽搬東西，力氣超大！",
   "instruct": "興奮又得意，想找人比賽"
  },
  {
   "id": "004",
   "role": "me_b",
   "text": "比力氣？怎麼比？",
   "instruct": "好奇地問"
  },
  {
   "id": "005",
   "role": "me_g",
   "text": "比力氣？怎麼比？",
   "instruct": "好奇地問"
  },
  {
   "id": "006",
   "role": "xiaomei",
   "text": "像相撲一樣！蹲低一點，手掌對手掌互推，腳先離開原地的人就輸了！",
   "instruct": "興高采烈地解釋玩法"
  },
  {
   "id": "007",
   "role": "devil",
   "text": "比就比！推贏她，讓大家看看你有多厲害！",
   "instruct": "壓低聲音，狡猾地慫恿"
  },
  {
   "id": "008",
   "role": "nar",
   "text": "你們面對面蹲低身體，手掌貼著手掌。",
   "instruct": "放慢，帶點緊張感"
  },
  {
   "id": "009",
   "role": "devil",
   "text": "蹲下去，手掌貼上去，用力推！",
   "instruct": "低聲催促，越說越急"
  },
  {
   "id": "010",
   "role": "xiaomei",
   "text": "我要贏了！你快被推出去了！",
   "instruct": "用力撐著，得意地喊"
  },
  {
   "id": "011",
   "role": "nar",
   "text": "小美越推越用力，你的腳往後滑了一步。",
   "instruct": "緊張起來，語速稍快"
  },
  {
   "id": "012",
   "role": "devil",
   "text": "你要輸了！突然用力推一下，她馬上就輸了！",
   "instruct": "急促地慫恿，帶著壞笑"
  },
  {
   "id": "013",
   "role": "xiaomei",
   "text": "好痛……我的頭……",
   "instruct": "痛得聲音發抖，很虛弱"
  },
  {
   "id": "014",
   "role": "me_b",
   "text": "對不起！你還好嗎？我去叫老師！",
   "instruct": "嚇壞了，慌張又著急"
  },
  {
   "id": "015",
   "role": "me_g",
   "text": "對不起！你還好嗎？我去叫老師！",
   "instruct": "嚇壞了，慌張又著急"
  },
  {
   "id": "016",
   "role": "devil",
   "text": "不要去！她又沒流血，告訴老師你就會被罵。",
   "instruct": "小聲地威脅，故意嚇人"
  },
  {
   "id": "017",
   "role": "xiaomei",
   "text": "……好像沒那麼痛了。不要告訴老師好不好？",
   "instruct": "忍著痛，小聲地拜託"
  },
  {
   "id": "018",
   "role": "me_b",
   "text": "……好吧。",
   "instruct": "猶豫很久，心虛地小聲答應"
  },
  {
   "id": "019",
   "role": "me_g",
   "text": "……好吧。",
   "instruct": "猶豫很久，心虛地小聲答應"
  },
  {
   "id": "020",
   "role": "teacher",
   "text": "小美，先不要動！老師馬上叫救護車，也通知你的家長。",
   "instruct": "緊急但冷靜，溫柔地安撫"
  },
  {
   "id": "021",
   "role": "nar",
   "text": "救護車很快就到了，把小美送到醫院檢查。",
   "instruct": "沉重，放慢"
  },
  {
   "id": "022",
   "role": "me_b",
   "text": "我以為她沒事了……那時候，我應該馬上告訴老師的……",
   "instruct": "後悔得快哭出來，聲音發抖"
  },
  {
   "id": "023",
   "role": "me_g",
   "text": "我以為她沒事了……那時候，我應該馬上告訴老師的……",
   "instruct": "後悔得快哭出來，聲音發抖"
  },
  {
   "id": "024",
   "role": "devil",
   "text": "是她自己說不要告訴老師的，不關你的事。",
   "instruct": "輕描淡寫地推卸責任"
  },
  {
   "id": "025",
   "role": "angel",
   "text": "手掌互推、拉手比力氣，只要有人突然用力或鬆手，另一個人就會往後倒，頭撞到地上。",
   "instruct": "認真地提醒，語氣溫柔"
  },
  {
   "id": "026",
   "role": "angel",
   "text": "頭撞到了，就算當下不痛，也要馬上告訴大人。我讓時間倒轉，回到小美來找你比力氣的時候，這一次，請你自己選。",
   "instruct": "溫柔而有力量，給人勇氣"
  },
  {
   "id": "027",
   "role": "xiaomei",
   "text": "我們來比力氣！像相撲一樣，手掌對手掌互推！",
   "instruct": "興奮又得意，想找人比賽"
  },
  {
   "id": "028",
   "role": "angel",
   "text": "這一次，你可以自己選。想一想，怎麼玩才安全？",
   "instruct": "溫柔地鼓勵，慢慢地說"
  },
  {
   "id": "029",
   "role": "nar",
   "text": "你們手掌對手掌互推，推著推著，你忍不住突然用力一推。",
   "instruct": "惋惜地說，語氣沉重，放慢"
  },
  {
   "id": "030",
   "role": "nar",
   "text": "你們拉著手往後拉，你一鬆手，小美整個人往後倒了下去。",
   "instruct": "惋惜地說，語氣沉重，放慢"
  },
  {
   "id": "031",
   "role": "nar",
   "text": "一開始輕輕的，可是推著推著越來越用力，小美一個沒站穩，往後倒了下去。",
   "instruct": "惋惜地說，語氣沉重，放慢"
  },
  {
   "id": "032",
   "role": "xiaomei",
   "text": "好啊！剪刀、石頭、布！我出石頭！",
   "instruct": "開心地喊口令"
  },
  {
   "id": "033",
   "role": "me_b",
   "text": "我出布，我贏了！",
   "instruct": "開心得意"
  },
  {
   "id": "034",
   "role": "me_g",
   "text": "我出布，我贏了！",
   "instruct": "開心得意"
  },
  {
   "id": "035",
   "role": "teacher",
   "text": "你們改玩猜拳，很好喔。手掌互推、拉手比力氣，只要一鬆手，就會往後倒。",
   "instruct": "欣慰地稱讚，再認真提醒"
  },
  {
   "id": "036",
   "role": "teacher",
   "text": "如果頭撞到了，就算不痛，也一定要告訴老師，回家也要告訴家人。",
   "instruct": "認真叮嚀，語氣溫柔"
  },
  {
   "id": "037",
   "role": "xiaomei",
   "text": "知道了！我們再來一次，剪刀、石頭、布！",
   "instruct": "開心地喊口令"
  },
  {
   "id": "038",
   "role": "nar",
   "text": "那天晚上，小美的頭越來越痛，一直吐，被救護車送到醫院。",
   "instruct": "沉重，放慢",
   "say": "那天晚上，小美的頭越來越痛，一直吐{ㄊㄨˋ}，被救護車送到醫院。"
  },
  {
   "id": "039",
   "role": "teacher",
   "text": "醫生說，小美的腦裡面在出血，昨天晚上緊急開刀了。",
   "instruct": "難過、沉重，盡量保持冷靜"
  },
  {
   "id": "040",
   "role": "me_b",
   "text": "怎麼會……那天她說已經不痛了……",
   "instruct": "不敢相信，聲音哽咽"
  },
  {
   "id": "041",
   "role": "me_g",
   "text": "怎麼會……那天她說已經不痛了……",
   "instruct": "不敢相信，聲音哽咽"
  },
  {
   "id": "042",
   "role": "teacher",
   "text": "頭撞到地面的傷，有時候過了好幾天才會出現。",
   "instruct": "語重心長"
  },
  {
   "id": "043",
   "role": "nar",
   "text": "小美的生命救回來了，可是她的右眼，只看得到一半的世界。",
   "instruct": "很沉重，最後一句放慢"
  },
  {
   "id": "044",
   "role": "angel",
   "text": "小惡魔，不准你再騙人了！",
   "instruct": "堅定有力地大聲說"
  },
  {
   "id": "045",
   "role": "devil",
   "text": "哇啊！好刺眼……我還會再回來的！",
   "instruct": "驚慌失措地大叫，邊說邊逃"
  },
  {
   "id": "046",
   "role": "angel",
   "text": "嗚……對不起，這一次我沒能保護大家……",
   "instruct": "難過地哭著說",
   "say": "對不起，這一次我沒能保護大家……"
  },
  {
   "id": "047",
   "role": "devil",
   "text": "你又被我騙了！走廊上推一下，小凱的頭骨就裂了，還要賠十二萬四千元！",
   "instruct": "得意洋洋地嘲笑"
  },
  {
   "id": "048",
   "role": "nar",
   "text": "放學了，你和小凱揹著書包走出教室，來到一樓走廊。",
   "instruct": "輕鬆地開場"
  },
  {
   "id": "049",
   "role": "xiaokai",
   "text": "我們來比賽！看誰先跑到走廊轉角，輸的人幫對方揹便當盒！",
   "instruct": "興奮好勝，想比賽"
  },
  {
   "id": "050",
   "role": "me_b",
   "text": "好啊，預備——",
   "instruct": "躍躍欲試"
  },
  {
   "id": "051",
   "role": "me_g",
   "text": "好啊，預備——",
   "instruct": "躍躍欲試"
  },
  {
   "id": "052",
   "role": "xiaokai",
   "text": "起跑！",
   "instruct": "大聲地喊"
  },
  {
   "id": "053",
   "role": "devil",
   "text": "衝啊！走廊又沒什麼人，跑快一點！",
   "instruct": "興奮地慫恿"
  },
  {
   "id": "054",
   "role": "nar",
   "text": "你們在走廊上狂奔，小凱領先你半個身體。",
   "instruct": "緊張起來，語速稍快"
  },
  {
   "id": "055",
   "role": "devil",
   "text": "跑快一點！不要輸給他！",
   "instruct": "急促地催促"
  },
  {
   "id": "056",
   "role": "xiaokai",
   "text": "我要贏了！便當盒你揹定了！",
   "instruct": "邊跑邊得意地喊"
  },
  {
   "id": "057",
   "role": "devil",
   "text": "你要輸了！伸手推他一下，他慢下來你就贏了！反正只是玩玩而已！",
   "instruct": "急促地慫恿，帶著壞笑"
  },
  {
   "id": "058",
   "role": "nar",
   "text": "小凱整個人往前撲倒，書包裡的課本掉了一地。他趴在地上一動也不動，你的手還停在半空中。",
   "instruct": "沉重，放慢，最後一句很輕"
  },
  {
   "id": "059",
   "role": "me_b",
   "text": "小凱？小凱！你不要嚇我！",
   "instruct": "嚇壞了，驚慌地大喊，快哭出來"
  },
  {
   "id": "060",
   "role": "me_g",
   "text": "小凱？小凱！你不要嚇我！",
   "instruct": "嚇壞了，驚慌地大喊，快哭出來"
  },
  {
   "id": "061",
   "role": "teacher",
   "text": "不要動他！你快去健康中心叫人，老師打一一九！",
   "instruct": "緊急但冷靜，清楚地下指令"
  },
  {
   "id": "062",
   "role": "nar",
   "text": "救護車很快就趕到了，把小凱送到醫院。",
   "instruct": "沉重，放慢"
  },
  {
   "id": "063",
   "role": "teacher",
