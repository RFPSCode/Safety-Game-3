 "lines": [
  {
   "id": "002",
   "role": "nar",
   "text": "下課時間，你在悠悅樓的平台上休息，小美跑了過來。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "003",
   "role": "xiaomei",
   "text": "我們來比力氣！我最近每天幫媽媽搬東西，力氣超大！",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "004",
   "role": "me_b",
   "text": "比力氣？怎麼比？",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "005",
   "role": "me_g",
   "text": "比力氣？怎麼比？",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "006",
   "role": "xiaomei",
   "text": "像相撲一樣！蹲低一點，手掌對手掌互推，腳先離開原地的人就輸了！",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "007",
   "role": "devil",
   "text": "比就比！推贏她，讓大家看看你有多厲害！",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "008",
   "role": "nar",
   "text": "你們面對面蹲低身體，手掌貼著手掌。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "009",
   "role": "devil",
   "text": "蹲下去，手掌貼上去，用力推！",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "010",
   "role": "xiaomei",
   "text": "我要贏了！你快被推出去了！",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "011",
   "role": "nar",
   "text": "小美越推越用力，你的腳往後滑了一步。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "012",
   "role": "devil",
   "text": "你要輸了！突然用力推一下，她馬上就輸了！",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "013",
   "role": "xiaomei",
   "text": "好痛……我的頭……",
   "instruct": "痛苦、虛弱地說"
  },
  {
   "id": "014",
   "role": "me_b",
   "text": "對不起！你還好嗎？我去叫老師！",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "015",
   "role": "me_g",
   "text": "對不起！你還好嗎？我去叫老師！",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "016",
   "role": "devil",
   "text": "不要去！她又沒流血，告訴老師你就會被罵。",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "017",
   "role": "xiaomei",
   "text": "……好像沒那麼痛了。不要告訴老師好不好？",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "018",
   "role": "me_b",
   "text": "……好吧。",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "019",
   "role": "me_g",
   "text": "……好吧。",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "020",
   "role": "teacher",
   "text": "小美，先不要動！老師馬上叫救護車，也通知你的家長。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "021",
   "role": "nar",
   "text": "救護車很快就到了，把小美送到醫院檢查。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "022",
   "role": "me_b",
   "text": "我以為她沒事了……那時候，我應該馬上告訴老師的……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "023",
   "role": "me_g",
   "text": "我以為她沒事了……那時候，我應該馬上告訴老師的……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "024",
   "role": "devil",
   "text": "是她自己說不要告訴老師的，不關你的事。",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "025",
   "role": "angel",
   "text": "手掌互推、拉手比力氣，只要有人突然用力或鬆手，另一個人就會往後倒，頭撞到地上。",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "026",
   "role": "angel",
   "text": "頭撞到了，就算當下不痛，也要馬上告訴大人。我讓時間倒轉，回到小美來找你比力氣的時候，這一次，請你自己選。",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "027",
   "role": "xiaomei",
   "text": "我們來比力氣！像相撲一樣，手掌對手掌互推！",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "028",
   "role": "angel",
   "text": "這一次，你可以自己選。想一想，怎麼玩才安全？",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "029",
   "role": "nar",
   "text": "你們手掌對手掌互推，推著推著，你忍不住突然用力一推。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "030",
   "role": "nar",
   "text": "你們拉著手往後拉，你一鬆手，小美整個人往後倒了下去。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "031",
   "role": "nar",
   "text": "一開始輕輕的，可是推著推著越來越用力，小美一個沒站穩，往後倒了下去。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "032",
   "role": "xiaomei",
   "text": "好啊！剪刀、石頭、布！我出石頭！",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "033",
   "role": "me_b",
   "text": "我出布，我贏了！",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "034",
   "role": "me_g",
   "text": "我出布，我贏了！",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "035",
   "role": "teacher",
   "text": "你們改玩猜拳，很好喔。手掌互推、拉手比力氣，只要一鬆手，就會往後倒。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "036",
   "role": "teacher",
   "text": "如果頭撞到了，就算不痛，也一定要告訴老師，回家也要告訴家人。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "037",
   "role": "xiaomei",
   "text": "知道了！我們再來一次，剪刀、石頭、布！",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "038",
   "role": "nar",
   "text": "那天晚上，小美的頭越來越痛，一直吐，被救護車送到醫院。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "039",
   "role": "teacher",
   "text": "醫生說，小美的腦裡面在出血，昨天晚上緊急開刀了。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "040",
   "role": "me_b",
   "text": "怎麼會……那天她說已經不痛了……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "041",
   "role": "me_g",
   "text": "怎麼會……那天她說已經不痛了……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "042",
   "role": "teacher",
   "text": "頭撞到地面的傷，有時候過了好幾天才會出現。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "043",
   "role": "nar",
   "text": "小美的生命救回來了，可是她的右眼，只看得到一半的世界。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "044",
   "role": "angel",
   "text": "小惡魔，不准你再騙人了！",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "045",
   "role": "devil",
   "text": "哇啊！好刺眼……我還會再回來的！",
   "instruct": "驚慌地大叫"
  },
  {
   "id": "046",
   "role": "angel",
   "text": "嗚……對不起，這一次我沒能保護大家……",
   "instruct": "難過地哭著說"
  },
  {
   "id": "047",
   "role": "devil",
   "text": "你又被我騙了！走廊上推一下，小凱的頭骨就裂了，還要賠十二萬四千元！",
   "instruct": "得意地大笑、嘲諷"
  },
  {
   "id": "048",
   "role": "nar",
   "text": "放學了，你和小凱揹著書包走出教室，來到一樓走廊。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "049",
   "role": "xiaokai",
   "text": "我們來比賽！看誰先跑到走廊轉角，輸的人幫對方揹便當盒！",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "050",
   "role": "me_b",
   "text": "好啊，預備——",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "051",
   "role": "me_g",
   "text": "好啊，預備——",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "052",
   "role": "xiaokai",
   "text": "起跑！",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "053",
   "role": "devil",
   "text": "衝啊！走廊又沒什麼人，跑快一點！",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "054",
   "role": "nar",
   "text": "你們在走廊上狂奔，小凱領先你半個身體。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "055",
   "role": "devil",
   "text": "跑快一點！不要輸給他！",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "056",
   "role": "xiaokai",
   "text": "我要贏了！便當盒你揹定了！",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "057",
   "role": "devil",
   "text": "你要輸了！伸手推他一下，他慢下來你就贏了！反正只是玩玩而已！",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "058",
   "role": "nar",
   "text": "小凱整個人往前撲倒，書包裡的課本掉了一地。他趴在地上一動也不動，你的手還停在半空中。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "059",
   "role": "me_b",
   "text": "小凱？小凱！你不要嚇我！",
   "instruct": "驚慌地大喊"
  },
  {
   "id": "060",
   "role": "me_g",
   "text": "小凱？小凱！你不要嚇我！",
   "instruct": "驚慌地大喊"
  },
  {
   "id": "061",
   "role": "teacher",
   "text": "不要動他！你快去健康中心叫人，老師打一一九！",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "062",
   "role": "nar",
   "text": "救護車很快就趕到了，把小凱送到醫院。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "063",
   "role": "teacher",
   "text": "不要動他！老師馬上打一一九！",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "064",
   "role": "nar",
   "text": "救護車很快就到了，把小凱送到醫院。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "065",
   "role": "me_b",
   "text": "如果那時候，我沒有伸手就好了……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "066",
   "role": "me_g",
   "text": "如果那時候，我沒有伸手就好了……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "067",
   "role": "devil",
   "text": "是他自己說要比賽的，又不是你一個人的錯。",
   "instruct": "狡猾、慫恿的語氣"
  },
  {
   "id": "068",
   "role": "angel",
   "text": "走廊不是賽跑場，轉角也看不到對面的人。伸手推人，可能害朋友一輩子受傷。",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "069",
   "role": "angel",
   "text": "我讓時間倒轉，回到小凱說要比賽的時候。這一次，請你自己選。",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "070",
   "role": "angel",
   "text": "這一次，你可以自己選。想一想，在走廊上該怎麼做？",
   "instruct": "溫柔堅定的語氣"
  },
  {
   "id": "071",
   "role": "nar",
   "text": "你們在走廊上狂奔，快要輸的時候，你忍不住伸手推了小凱一下。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "072",
   "role": "devil",
   "text": "你又被我騙了！你沒有勸小凱別跑，他在轉角撞倒了小美！",
   "instruct": "得意地大笑、嘲諷"
  },
  {
   "id": "073",
   "role": "nar",
   "text": "小凱一個人衝了出去，在轉角撞上抱著作業簿走過來的小美。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "074",
   "role": "xiaomei",
   "text": "好痛！我的作業簿……",
   "instruct": "痛苦地說"
  },
  {
   "id": "075",
   "role": "xiaokai",
   "text": "對不起！我沒看到你從轉角走過來……",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "076",
   "role": "teacher",
   "text": "小美，手先不要動，老師帶你去健康中心。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "077",
   "role": "nar",
   "text": "小美的手腕扭傷了，作業簿也散了一地。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "078",
   "role": "devil",
   "text": "你又被我騙了！快走也停不下來，轉角一撞，小美就受傷了！",
   "instruct": "得意地大笑、嘲諷"
  },
  {
   "id": "079",
   "role": "nar",
   "text": "你們越走越快，小凱在轉角撞上了抱著作業簿走過來的小美。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "080",
   "role": "xiaokai",
   "text": "對不起！我走太快，停不下來……",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "081",
   "role": "xiaokai",
   "text": "好啦，那體育課再比！反正我一定贏。",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "082",
   "role": "xiaomei",
   "text": "幸好你們沒有用跑的，不然我一定被撞倒。",
   "instruct": "活潑的小女孩語氣"
  },
  {
   "id": "083",
   "role": "teacher",
   "text": "走廊不是賽跑場。轉角看不到對面的人，跑太快就停不下來。你們今天做得很好。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "084",
   "role": "xiaokai",
   "text": "體育課見！這次我們在操場好好比一場！",
   "instruct": "活潑好勝的小男孩語氣"
  },
  {
   "id": "085",
   "role": "nar",
   "text": "小凱的頭骨裂了，腦裡面也在出血。臉的一邊動不太起來，一邊的耳朵也聽不清楚了。",
   "instruct": "平穩的說故事語氣，清楚自然"
  },
  {
   "id": "086",
   "role": "teacher",
   "text": "監視器拍得很清楚，是伸手推人。這不是玩玩而已了。",
   "instruct": "溫和關心的語氣"
  },
  {
   "id": "087",
   "role": "me_b",
   "text": "我只是想贏……我不知道會這樣……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "088",
   "role": "me_g",
   "text": "我只是想贏……我不知道會這樣……",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "089",
   "role": "devil",
   "text": "你又被我騙了！小美往後倒，後腦撞到地上。頭撞到的傷，有時候過了好幾天才會出事！",
   "instruct": ""
  },
  {
   "id": "090",
   "role": "devil",
   "text": "你又被我騙了！從滑道往上爬，手都摔斷了！現在大家都不敢玩溜滑梯了！",
   "instruct": ""
  },
  {
   "id": "091",
   "role": "nar",
   "text": "下課了，你和小凱在遊樂器材區，排隊等著爬攀爬網上溜滑梯。小宇已經在上面的平台了。",
   "instruct": ""
  },
  {
   "id": "092",
   "role": "xiaokai",
   "text": "排隊好慢喔。你不是說你手腳最快？我才不信。",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "093",
   "role": "me_b",
   "text": "誰說的？我可以證明給你看。",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "094",
   "role": "me_g",
   "text": "誰說的？我可以證明給你看。",
   "instruct": "小學生自然的語氣"
  },
  {
   "id": "095",
   "role": "devil",
   "text": "幹嘛排隊爬網子？直接從滑道爬上去！又快又帥，證明給小凱看！",
   "instruct": ""
  },
  {
   "id": "096",
   "role": "nar",
   "text": "溜滑梯的滑道就在旁邊，從下面看，好像很快就能爬到頂。",
   "instruct": ""
  },
  {
   "id": "097",
   "role": "devil",
